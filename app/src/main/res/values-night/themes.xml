<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="CustomActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="android:background">@color/dark_background</item>
        <item name="titleTextColor">@color/dark_text_primary</item>
    </style>

    <style name="Theme.Dictionary" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_text_primary</item>
        <item name="colorPrimaryVariant">@color/dark_text_primary</item>
        <item name="colorOnPrimary">@color/dark_background</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/dark_text_secondary</item>
        <item name="colorSecondaryVariant">@color/dark_text_secondary</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Background color. -->
        <item name="android:windowBackground">@color/dark_background</item>
        <!-- Text color. -->
        <item name="android:textColor">@color/dark_text_primary</item>
        <!-- No animations for better e-ink experience -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Action bar styling -->
        <item name="actionBarStyle">@style/CustomActionBar</item>
        <!-- Remove action bar completely for custom implementation -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>